{
  "name": "crux-cli",
  "version": "0.1.0",
  "description": "Wraps a test runner, emits failures-only summary. Same pipeline via CLI and MCP.",
  "keywords": [
    "test-runner",
    "vitest",
    "mcp",
    "cli",
    "agents",
    "model-context-protocol"
  ],
  "homepage": "https://github.com/slgoodrich/crux-cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slgoodrich/crux-cli.git"
  },
  "bugs": {
    "url": "https://github.com/slgoodrich/crux-cli/issues"
  },
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "crux": "dist/cli.js",
    "crux-mcp": "dist/mcp/server.js"
  },
  "files": [
    "dist/",
    "docs/AGENTS.md",
    "docs/skills/",
    "docs/using-claude-code.md",
    "docs/mcp-hosts.md",
    "docs/report-v0.1.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p .",
    "lint": "biome check",
    "format": "biome check --write",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "token-bench": "tsx scripts/token-bench.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,json,jsonc}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "execa": "9.6.1",
    "zod": "^4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@types/node": "^25.6.2",
    "@vitest/coverage-v8": "^4.1.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "shell-cassette": "^0.6.2",
    "tiktoken": "^1",
    "tsx": "^4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
